// Release ビルド専用設定

// Release 用 Info.plist（UIFileSharingEnabled=false を Boolean 型で設定）
INFOPLIST_FILE = eMeishi/Info.plist

// Swift コンパイル条件（#if DEBUG ブロックをすべて除去）
// → 開発者セクション・seedSampleData・CloudKitModelUploader がビルドから除外される
SWIFT_ACTIVE_COMPILATION_CONDITIONS =

// テスト可能性不要（最適化優先）
ENABLE_TESTABILITY = NO

// Run Script Build Phase からビルド成果物を書き換えるため sandbox を無効化
ENABLE_USER_SCRIPT_SANDBOXING = NO

// Swift 6 移行 Phase 6: Strict Concurrency を complete に昇格し Swift 6 言語モードを有効化
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_VERSION = 6.0
