{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.p8)",
      "Read(./secrets/**)",
      "Read(./private/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "git branch --show-current 2>/dev/null | sed 's/^/branch: /'",
    "refreshInterval": 5
  },
  "respectGitignore": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/enforce-skills.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-git.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/guard-files.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-docs-sync.sh"
          }
        ]
      }
    ]
  }
}
